{
  "expo": {
    "name": "Cook-IT",
    "slug": "cookit-mobile",
    "originalFullName": "@worrador/cookit-mobile",
    "version": "1.0.0",
    "description": "Cook-IT keeps your recipes organized, tracks cooking history, and optionally syncs your recipe book securely with your Google Drive.",
    "orientation": "portrait",
    "icon": "./assets/ChefHatColored.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/ChefHatColored.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "scheme": "cook-it-mobile"
    },
    "android": {
      "package": "com.worrador.cookitmobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/ChefHatColored.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "scheme": "cook-it-mobile",
      "versionCode": 13
    },
    "web": {
      "favicon": "./assets/ChefHatColored.png"
    },
    "scheme": "cook-it-mobile",
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cook-IT uses your photo library to attach photos of recipes to your recipe book.",
          "cameraPermission": "Cook-IT uses your camera to photograph recipe pages (e.g. from a cookbook) and attach them to a recipe."
        }
      ],
      "./plugins/withTransparentNavigationBar"
    ],
    "extra": {
      "eas": {
        "projectId": "7c196cfa-6a72-4f0b-9cc7-a9aa007d9009"
      }
    }
  }
}
